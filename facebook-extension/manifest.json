{
  "manifest_version": 3,
  "name": "ClipHarbor Post — Facebook companion",
  "version": "0.9.0",
  "minimum_chrome_version": "120",
  "description": "Optional companion: publish an explicitly exported video and caption through your own signed-in Facebook profile.",
  "key": "",
  "permissions": ["debugger", "scripting", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://www.facebook.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "ClipHarbor Facebook posting", "default_popup": "popup.html", "default_icon": "icon.png"},
  "icons": {"128": "icon.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
