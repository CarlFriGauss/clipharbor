{
  "manifest_version": 3,
  "name": "ClipHarbor — Download this video",
  "version": "0.9.2",
  "minimum_chrome_version": "120",
  "description": "Send a video or link to your installed ClipHarbor app. Download to your computer or your connected Google Drive.",
  "key": "",
  "permissions": ["activeTab", "scripting", "contextMenus", "nativeMessaging", "storage", "alarms"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Download with ClipHarbor", "default_popup": "popup.html", "default_icon": "icon.png"},
  "icons": {"128": "icon.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
